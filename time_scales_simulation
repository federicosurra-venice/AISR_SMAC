import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import solve_ivp

# --- fonts in figure ---
plt.rcParams.update({
    "font.size": 24,          # base
    "axes.labelsize": 28,     # axis
    "xtick.labelsize": 24,    # tick x
    "ytick.labelsize": 24,    # tick y
    "legend.fontsize": 26,    # legenda
})

# ---  model function  ---
def Adaptive_Immune_System_Response(t, z, A, D, T, E, B,
                                    k6, k9, k7, k11, k12, k13, k14, k15,
                                    k16, k17, k18, k19, k22, k23, k25,
                                    f13, Q13_M):
    Q2, Q3, Q4, Q5, Q6, Q7 = z
    Q13 = Q13_M - f13 * Q6
    return [
        k6 * A * T - k9 * Q2,
        k7 * A * D - k11 * Q3,
        k12 * E * Q4 + k13 * Q2 * B - k14 * Q4 * Q3 - k15 * Q4,
        k14 * Q4 * Q3 - k16 * Q5 - k17 * Q5 * Q13 - k18 * Q5,
        k19 * Q5 * Q13 - k22 * Q6 - k23 * Q6,
        k16 * Q5 + k22 * Q6 - k25 * Q7
    ]

D, T, B, E, A = 40e6, 8.5e9, 0.4e9, 1, 2e6
k6, k7 = 28e-9, 6e-6
k9, k11, k12, k13, k14, k15 = 0.7, 0.9, 0.019/E, 1e-9, 2e-9, 0.4
f13, Q13_M = 1, 1e9
k16, k17, k18, k19, k22, k23, k25 =  3.4e-9, 4.8/Q13_M, 0.33, 4.8/Q13_M, 3.4e-9, 2.7e-5, 0.07 #/Q13_M

# --- base parameters for step simulation ---
base_params = {
    "A":    A,
    "D":    D,
    "T":    T,
    "E":    E,
    "B":    B,
    "k6":   k6,   "k9":   k9,
    "k7":   k7,    "k11":  k11,
    "k12":  k12,   "k13":  k13,   "k14": k14,   "k15":  k15,
    "k16":  k16,  "k17":  k17,   "k18":  k18,
    "k19":  k19,   "k22":   k22,   "k23": k23,  "k25":  k25,
    "f13":  f13,      "Q13_M": Q13_M
}

# horizons & time grids
durations = [10, 365, 29220]
t_grids   = [np.linspace(0, d, nt) for d, nt in zip(durations, [100,1000,10000])]

# scale factors
factors = [0.95, 1.0, 1.05]

# prepare storage: for each horizon index, collect one list per factor
second_sims = {i: [] for i in range(len(durations))}

for f in factors:
    # --- 1-day sim to get ICs ---
    p = {k: f * v for k, v in base_params.items()}
    t1 = np.linspace(0, 1, 10)
    sol1 = solve_ivp(
        Adaptive_Immune_System_Response,
        [0, 1],
        [0,0,0,0,0,0],
        t_eval=t1,
        method='Radau',
        args=(
            p["A"], p["D"], p["T"], p["E"], p["B"],
            p["k6"], p["k9"], p["k7"], p["k11"],
            p["k12"], p["k13"], p["k14"], p["k15"],
            p["k16"], p["k17"], p["k18"],
            p["k19"], p["k22"], p["k23"], p["k25"],
            p["f13"], p["Q13_M"]
        )
    )
    Q20t, Q30t, Q40t, Q50t, Q60t, Q70t = sol1.y[:, -1]

    # --- step sims from those ICs ---
    for i, (DT, t_eval) in enumerate(zip(durations, t_grids)):
        sol2 = solve_ivp(
            Adaptive_Immune_System_Response,
            [0, DT],
            [Q20t, Q30t, Q40t, Q50t, Q60t, Q70t],
            t_eval=t_eval,
            method='Radau',
            args=(
                0, p["D"], p["T"], p["E"], p["B"], #A = 0
                p["k6"], p["k9"], p["k7"], p["k11"],
                p["k12"], p["k13"], p["k14"], p["k15"],
                p["k16"], p["k17"], p["k18"],
                p["k19"], p["k22"], p["k23"], p["k25"],
                p["f13"], p["Q13_M"]
            )
        )
        second_sims[i].append(sol2.y)   # shape (6, len(t_eval))

# --- plot mean ± envelope with twin axes for Q7 ---
labels = ["Q1","Q2","Q3","Q4","Q5","Q6"]
colors = ["r","orange","green","cyan","purple","blue"]

fig, axes = plt.subplots(1, 3, figsize=(36,12), dpi=400, sharey=False)

for i, ax in enumerate(axes):
    # stack: shape (n_factors=3, n_vars=6, n_times)
    arr   = np.stack(second_sims[i], axis=0)
    mean  = arr.mean(axis=0)
    lo    = arr.min(axis=0)
    hi    = arr.max(axis=0)
    t_eval = t_grids[i]

    # plot Q2–Q6 on primary axis
    main_handles = []
    for j in range(5):  # indices 0..4 correspond to Q2..Q6
        h, = ax.plot(t_eval, mean[j], color=colors[j], label=labels[j])
        ax.fill_between(t_eval, lo[j], hi[j], color=colors[j], alpha=0.2)
        main_handles.append(h)
    ax.set_xlabel(r"$time$ $from$ $first$ $exposure$ $(days)$", size=28)
    ax.set_ylabel(r"$Q$ $(n. cells)$", size=28)
    ax.tick_params(labelsize=24)
    ax.ticklabel_format(style='sci', useMathText=True)
    ax.yaxis.offsetText.set_fontsize(24)

    # twin y‐axis for Q7 (antibodies in grams)
    ax2 = ax.twinx()
    h7, = ax2.plot(t_eval, mean[5], color=colors[5], label=labels[5])
    ax2.fill_between(t_eval, lo[5], hi[5], color=colors[5], alpha=0.2)
    ax2.set_ylabel(r"$Q_6$ $(g antibodies)$", size=28)
    ax2.tick_params(labelsize=24)
    
    # combined legend
    handles = main_handles + [h7]
    labs    = labels[:5] + [labels[5]]
    ax.grid(ls=":")

# panels
axes[0].text(0.5,   3.8e8, r"$A.$", size=34, fontweight="heavy")
axes[1].text(22,    3.8e8, r"$B.$", size=34, fontweight="heavy")
axes[2].text(3500,  3.8e8, r"$C.$", size=34, fontweight="heavy")

# legenda
axes[0].legend(handles, labs, loc='upper center', fontsize=26)

plt.tight_layout()
plt.show()
