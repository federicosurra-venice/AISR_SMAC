import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import solve_ivp
import matplotlib.patches as mpatches
import os

# =============================================================================
# (1) MODEL DEFINITION 
# =============================================================================
def Adaptive_Immune_System_Response(t, z, A, D, T, E, B,
                                    k1, k10, k2, k20, k3, kE, k4, k30,
                                    k8, k9, k40, k5, k6, k50, k60,
                                    f13, Q13_M):
    Q2, Q3, Q4, Q5, Q6, Q7 = z
    Q13 = Q13_M - f13 * Q6

    dQ2 = k1  * A * T - k10 * Q2
    dQ3 = k2  * A * D - k20 * Q3
    dQ4 = k3  * E * Q4 + kE * Q2 * B - k4  * Q4 * Q3 - k30 * Q4
    dQ5 = k4  * Q4 * Q3 - k8  * Q5 - k9  * Q5 * Q13 - k40 * Q5
    dQ6 = k5  * Q5 * Q13 - k6  * Q6 - k50 * Q6
    dQ7 = k8  * Q5 + k6  * Q6 - k60 * Q7

    return [dQ2, dQ3, dQ4, dQ5, dQ6, dQ7]

# =============================================================================
# (2) RUN TWO-STAGE SIMULATION
# =============================================================================
def run_two_stage_simulation(params_dict,
                             perturb_name=None,
                             perturb_frac=0.0,
                             t_eval_stage2=None):
    k1   = params_dict["k1"]
    k2   = params_dict["k2"]
    k3   = params_dict["k3"]
    k4   = params_dict["k4"]
    k5   = params_dict["k5"]
    k6   = params_dict["k6"]
    k8   = params_dict["k8"]
    k9   = params_dict["k9"]
    k10  = params_dict["k10"]
    k20  = params_dict["k20"]
    k30  = params_dict["k30"]
    k40  = params_dict["k40"]
    k50  = params_dict["k50"]
    k60  = params_dict["k60"]
    kE   = params_dict["kE"]
    f13  = params_dict["f13"]
    Q13_M = params_dict["Q13_M"]

    if (perturb_name is not None) and (perturb_frac != 0.0):
        if perturb_name in params_dict:
            if   perturb_name == "k1":   k1  = params_dict["k1"]  * (1 + perturb_frac)
            elif perturb_name == "k2":   k2  = params_dict["k2"]  * (1 + perturb_frac)
            elif perturb_name == "k3":   k3  = params_dict["k3"]  * (1 + perturb_frac)
            elif perturb_name == "k4":   k4  = params_dict["k4"]  * (1 + perturb_frac)
            elif perturb_name == "k5":   k5  = params_dict["k5"]  * (1 + perturb_frac)
            elif perturb_name == "k6":   k6  = params_dict["k6"]  * (1 + perturb_frac)
            elif perturb_name == "k8":   k8  = params_dict["k8"]  * (1 + perturb_frac)
            elif perturb_name == "k9":   k9  = params_dict["k9"]  * (1 + perturb_frac)
            elif perturb_name == "k10":  k10 = params_dict["k10"] * (1 + perturb_frac)
            elif perturb_name == "k20":  k20 = params_dict["k20"] * (1 + perturb_frac)
            elif perturb_name == "k30":  k30 = params_dict["k30"] * (1 + perturb_frac)
            elif perturb_name == "k40":  k40 = params_dict["k40"] * (1 + perturb_frac)
            elif perturb_name == "k50":  k50 = params_dict["k50"] * (1 + perturb_frac)
            elif perturb_name == "k60":  k60 = params_dict["k60"] * (1 + perturb_frac)
            elif perturb_name == "kE":   kE  = params_dict["kE"]  * (1 + perturb_frac)
            elif perturb_name == "f13":  f13 = params_dict["f13"] * (1 + perturb_frac)
            elif perturb_name == "Q13_M": Q13_M = params_dict["Q13_M"] * (1 + perturb_frac)
        else:
            raise ValueError(f"Unknown parameter '{perturb_name}'")

    DT_seed = 1.0
    t_seed  = np.linspace(0.0, DT_seed, 10)

    A0, D0, T0, B0, E0 = 1e6, 40e6, 8.5e9, 0.4e9, 1.0
    z0 = [0.0]*6

    sol_seed = solve_ivp(
        Adaptive_Immune_System_Response,
        [0.0, DT_seed],
        z0,
        t_eval=t_seed,
        method="Radau",
        args=(A0, D0, T0, E0, B0,
              k1, k10, k2, k20, k3, kE, k4, k30,
              k8, k9, k40, k5, k6, k50, k60,
              f13, Q13_M)
    )

    Q20t, Q30t, Q40t, Q50t, Q60t, Q70t = sol_seed.y[:, -1]

    if t_eval_stage2 is None:
        raise ValueError("Please supply t_eval_stage2 for the longer run!")

    A1, D1, T1, B1, E1 = 0.0, 40e6, 8.5e9, 0.4e9, 1.0
    z_initial_long = [Q20t, Q30t, Q40t, Q50t, Q60t, Q70t]

    sol_long = solve_ivp(
        Adaptive_Immune_System_Response,
        [0.0, t_eval_stage2[-1]],
        z_initial_long,
        t_eval=t_eval_stage2,
        method="Radau",
        args=(A1, D1, T1, E1, B1,
              k1, k10, k2, k20, k3, kE, k4, k30,
              k8, k9, k40, k5, k6, k50, k60,
              f13, Q13_M)
    )

    return t_eval_stage2, sol_long.y

# =============================================================================
# (3) BASELINE PARAMETERS
# =============================================================================
baseline_params = {
    "k1":   28e-9,
    "k2":   6e-6,
    "k10":  0.7,
    "k20":  0.9,
    "k3":   0.019/1.0,
    "kE":   1e-9,
    "k4":   2e-9,
    "k30":  0.4,
    "k8":   3.4e-9,
    "k9":   6e-9,
    "k40":  0.33,
    "k5":   6e-9,
    "k6":   1e-9,
    "k50":  2.7e-5,
    "k60":  0.07,
    "f13":  1.0,
    "Q13_M": 1e9
}

param_names = ["k1","k2","k10","k20","k3","kE","k4","k30",
               "k8","k9","k40","k5","k6","k50","k60"]

delta = 0.25

# =============================================================================
# (4) TIME GRIDS
# =============================================================================
t10    = np.linspace(0.0,  10.0,  200)
t365   = np.linspace(0.0, 365.0, 1000)
t29220 = np.linspace(0.0, 80.0*365.0, 4000)

# =============================================================================
# (5) RUN SENSITIVITY
# =============================================================================
results_10d = {p: {} for p in param_names}
results_1y  = {p: {} for p in param_names}
results_80y = {p: {} for p in param_names}

print("Starting sensitivity runs...")

for pname in param_names:
    t_b, z_b = run_two_stage_simulation(baseline_params, None, 0.0, t10)
    results_10d[pname]["baseline"] = (t_b, z_b)
    t_m, z_m = run_two_stage_simulation(baseline_params, pname, -delta, t10)
    results_10d[pname]["minus"] = (t_m, z_m)
    t_p, z_p = run_two_stage_simulation(baseline_params, pname, +delta, t10)
    results_10d[pname]["plus"] = (t_p, z_p)

    t_b, z_b = run_two_stage_simulation(baseline_params, None, 0.0, t365)
    results_1y[pname]["baseline"] = (t_b, z_b)
    t_m, z_m = run_two_stage_simulation(baseline_params, pname, -delta, t365)
    results_1y[pname]["minus"] = (t_m, z_m)
    t_p, z_p = run_two_stage_simulation(baseline_params, pname, +delta, t365)
    results_1y[pname]["plus"] = (t_p, z_p)

    t_b, z_b = run_two_stage_simulation(baseline_params, None, 0.0, t29220)
    results_80y[pname]["baseline"] = (t_b, z_b)
    t_m, z_m = run_two_stage_simulation(baseline_params, pname, -delta, t29220)
    results_80y[pname]["minus"] = (t_m, z_m)
    t_p, z_p = run_two_stage_simulation(baseline_params, pname, +delta, t29220)
    results_80y[pname]["plus"] = (t_p, z_p)

    print(f"  → Completed parameter '{pname}'")

print("All sensitivity runs completed.")

# =============================================================================
# (6) PLOTTING FUNCTION 
# =============================================================================
def plot_sensitivity_grid(results_dict, t_scale, max_time, xlabel,
                          figsize=(16, 10), save_name="sensitivity.png"):
    n_params = len(results_dict)
    ncols    = 5
    nrows    = int(np.ceil(n_params / ncols))
    fig, axes = plt.subplots(nrows, ncols, figsize=figsize, sharex=True, sharey=True)
    axes = axes.flatten()

    Q_colors = {0:"r",1:"orange",2:"green",3:"cyan",4:"purple",5:"b"}

    for idx, pname in enumerate(results_dict.keys()):
        ax = axes[idx]
        t_b, z_b = results_dict[pname]["baseline"]
        t_m, z_m = results_dict[pname]["minus"]
        t_p, z_p = results_dict[pname]["plus"]

        if t_scale == "days":
            x_b, x_m, x_p, x_max = t_b, t_m, t_p, max_time
        elif t_scale == "months":
            x_b, x_m, x_p = t_b/30.0, t_m/30.0, t_p/30.0
            x_max = max_time/30.0
        elif t_scale == "years":
            x_b, x_m, x_p = t_b/365.0, t_m/365.0, t_p/365.0
            x_max = max_time/365.0
        else:
            raise ValueError

        for qi in range(6):
            y_b, y_minus, y_plus = z_b[qi,:], z_m[qi,:], z_p[qi,:]
            if qi == 5:
                y_b, y_minus, y_plus = y_b*1e8, y_minus*1e8, y_plus*1e8
            ax.plot(x_b, y_b, color=Q_colors[qi], linewidth=1.4)
            ax.fill_between(x_b, y_minus, y_plus, color=Q_colors[qi], alpha=0.2)

        ax.set_title(f"{pname} ± Δ{pname}", fontsize=12)
        ax.set_xlim(0, x_max)
        ax.tick_params(axis='both', which='major', labelsize=12)
        if (idx % ncols) == 0:
            ax.set_ylabel("Stock levels (Q₁…Q₆)", fontsize=13)
        if (idx // ncols) == (nrows - 1):
            ax.set_xlabel(xlabel, fontsize=13)

    for j in range(n_params, nrows*ncols):
        fig.delaxes(axes[j])

    legend_lines, legend_labels = [], []
    for qi in range(6):
        legend_lines.append(plt.Line2D([], [], color=Q_colors[qi], lw=1.8))
        legend_labels.append(f"Q{qi+1}")
    for qi in range(6):
        patch = mpatches.Patch(facecolor=Q_colors[qi], alpha=0.2, edgecolor=None)
        legend_lines.append(patch)
        legend_labels.append(f"± ΔQ{qi+1}")

    # Reserve space on the RIGHT
    fig.subplots_adjust(left=0.06, right=0.80, top=0.90, bottom=0.08)

    # Legend placed in reserved right margin (always visible)
    fig.legend(
        legend_lines, legend_labels,
        loc="center left", bbox_to_anchor=(0.82, 0.5),
        ncol=1, frameon=False,
        title="Stocks and uncertainty",
        fontsize=12, title_fontsize=13
    )

    plt.suptitle("OPT Sensitivity analysis", fontsize=18, y=0.965)
    fig.savefig(save_name, dpi=300)
    print(f"Saved sensitivity figure → {save_name}")
    plt.close(fig)

# =============================================================================
# (7) PRODUCE FIGURES
# =============================================================================
outdir = os.path.expanduser(".")
if not os.path.isdir(outdir): os.makedirs(outdir)

plot_sensitivity_grid(results_10d, "days", 10, "Days", save_name=os.path.join(outdir, "sens_10day.png"))
plot_sensitivity_grid(results_1y, "months", 365, "Months", save_name=os.path.join(outdir, "sens_1year.png"))
plot_sensitivity_grid(results_80y, "years", 80*365, "Years", save_name=os.path.join(outdir, "sens_80year.png"))

print("Done. Figures saved without legend overlap.")
